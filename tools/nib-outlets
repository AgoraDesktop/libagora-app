#!/usr/bin/env python3
#
# nib-outlets — the two declarations a nib can name, read out of a class's header by the compiler that already
# understands them.
#
# Copyright © 2026 Kyle J. Cardoza.
# SPDX-FileCopyrightText: 2026 Kyle J. Cardoza
# SPDX-License-Identifier: GPL-3.0-or-later
#
# **WHY THIS EXISTS.** `NSNibDeclarations.h` records that clang pre-defines `IBOutlet` and `IBAction` as
# ATTRIBUTES, and that the AST therefore carries them on the ivar, the property and the method. This tool is the
# reader: it answers, per class, the outlets and actions a design file may name — which is exactly what an
# editor's "Connect" list needs and what `class_copyIvarList` cannot answer, because storage is not intent (a
# `delegate` ivar looks exactly like an outlet).
#
# IT SHELLS OUT TO CLANG RATHER THAN LINKING LIBCLANG. One flag (`-Xclang -ast-dump=json`) and no library
# dependency; the tree is clang-only already, and a JSON document is a fact that can be diffed, committed and
# tested, which a C API's in-memory cursors are not.
#
#   nib-outlets --include DIR [--include DIR ...] Header.h ...      → JSON on stdout
#   nib-outlets --c ...                                             → a C table a program compiles in
#   nib-outlets --check EXPECTED.json ...                           → exit 0 when the rows match, 1 otherwise
#
# THE NAMES ARE NORMALISED THE WAY KVC NORMALISES THEM: an ivar `_runButton` is the outlet `runButton`, because
# `-setValue:forKey:` looks for `_runButton` under that key.

import argparse
import json
import os
import subprocess
import sys

CLANG = os.environ.get("AGORA_CLANG", "/usr/bin/clang-19")


def ast_json(headers, includes, extra):
    # **`-fobjc-runtime=macosx` IS FOR THE ANALYSIS, NOT THE BUILD**, and it is not a preference: with this
    # machine's clang 19, `-ast-dump=json` and the gnustep runtime SEGFAULT inside
    # `MangleContext::mangleObjCMethodName` (measured on the fixture below, every time). The attributes this
    # tool reads are runtime-independent — an `IBOutletAttr` is on the declaration before any ABI exists — so
    # the dump is taken with the runtime whose mangling clang can do.
    cmd = [CLANG, "-x", "objective-c", "-fsyntax-only", "-fblocks", "-Xclang", "-ast-dump=json",
           "-fobjc-runtime=macosx"]
    for inc in includes:
        cmd.append("-I" + inc)
    cmd.extend(extra)
    cmd.extend(headers)
    done = subprocess.run(cmd, capture_output=True, text=True)
    if done.returncode != 0:
        sys.stderr.write(done.stderr)
        raise SystemExit(f"nib-outlets: clang refused the headers (exit {done.returncode})")
    return json.loads(done.stdout)


def attr_kinds(node):
    return {c.get("kind") for c in node.get("inner", [])}


def strip_underscore(name):
    return name[1:] if name.startswith("_") else name


def walk(node, current_class, classes):
    kind = node.get("kind")

    if kind in ("ObjCInterfaceDecl", "ObjCCategoryDecl", "ObjCClassForwardDecl"):
        if kind != "ObjCClassForwardDecl" and node.get("name"):
            current_class = node["name"]
            classes.setdefault(current_class, {"outlets": [], "actions": []})
    if kind in ("ObjCIvarDecl", "ObjCPropertyDecl") and current_class and "IBOutletAttr" in attr_kinds(node):
        key = strip_underscore(node.get("name", ""))
        if key:
            entry = {"key": key, "type": node.get("type", {}).get("qualType", "id")}
            if entry not in classes[current_class]["outlets"]:
                classes[current_class]["outlets"].append(entry)
    if kind in ("ObjCMethodDecl", "ObjCProtocolMethodDecl") and current_class and "IBActionAttr" in attr_kinds(node):
        selector = node.get("name", "")		# clang's `name` already carries the colons
        if selector and selector not in classes[current_class]["actions"]:
            classes[current_class]["actions"].append(selector)

    for child in node.get("inner", []):
        walk(child, current_class, classes)


def collect(headers, includes, extra):
    tree = ast_json(headers, includes, extra)
    classes = {}
    walk(tree, None, classes)
    return {name: data for name, data in classes.items()
            if data["outlets"] or data["actions"]}


def as_c(classes):
    out = ["/* generated by nib-outlets — do not edit */",
           "typedef struct { const char *cls; const char *key; const char *type; const char *kind; } AGDesignBinding;",
           "static const AGDesignBinding kAGDesignBindings[] = {"]
    for name in sorted(classes):
        for outlet in classes[name]["outlets"]:
            out.append(f'\t{{ "{name}", "{outlet["key"]}", "{outlet["type"]}", "outlet" }},')
        for action in classes[name]["actions"]:
            out.append(f'\t{{ "{name}", "{action}", "SEL", "action" }},')
    out.append("\t{ 0, 0, 0, 0 }")
    out.append("};")
    return "\n".join(out) + "\n"


def main():
    parser = argparse.ArgumentParser(prog="nib-outlets")
    parser.add_argument("headers", nargs="+")
    parser.add_argument("--include", action="append", default=[])
    parser.add_argument("--clang-arg", action="append", default=[])
    parser.add_argument("--c", action="store_true")
    parser.add_argument("--check")
    args = parser.parse_args()

    classes = collect(args.headers, args.include, args.clang_arg)

    if args.check:
        with open(args.check) as handle:
            expected = json.load(handle)
        expected = expected.get("classes", expected)
        if expected != classes:
            print("nib-outlets: mismatch", file=sys.stderr)
            print(json.dumps(expected, indent=2, sort_keys=True), file=sys.stderr)
            print(json.dumps(classes, indent=2, sort_keys=True), file=sys.stderr)
            return 1
        print(f"ok: {sum(len(c['outlets']) for c in classes.values())} outlet(s) and "
              f"{sum(len(c['actions']) for c in classes.values())} action(s) in {len(classes)} class(es)")
        return 0

    if args.c:
        sys.stdout.write(as_c(classes))
    else:
        sys.stdout.write(json.dumps({"classes": classes}, indent=2, sort_keys=True) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
